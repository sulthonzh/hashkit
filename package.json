{
  "name": "@quadbyte/hashkit",
  "version": "1.0.0",
  "description": "Zero-dependency non-cryptographic hash functions for Node.js — murmurhash3, FNV-1a, DJB2, xxHash32, CRC32, and more",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "hashkit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc && node --test dist/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "hash",
    "murmurhash",
    "fnv",
    "xxhash",
    "crc32",
    "djb2",
    "non-cryptographic",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "sulthonzh",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/test/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sulthonzh/hashkit.git"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  }
}
